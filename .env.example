# PostgreSQL — universal Docker credentials (same on every machine)
# Do NOT change these to your OS username. Start the DB with: npm run db:up
# Must match docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/witchcraft_sim?schema=public"

# Server
PORT=2567
NODE_ENV=development

# Client dev proxy target (optional)
VITE_SERVER_URL="http://localhost:2567"

# Admin JWT secret (change in production!)
ADMIN_JWT_SECRET="change-me-in-production"
PLAYER_JWT_SECRET="change-me-player-secret"
ADMIN_DEFAULT_PASSWORD="admin123"
