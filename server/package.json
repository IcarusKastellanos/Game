{
  "name": "@witchcraft/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../prisma/schema.prisma",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:admin": "tsx src/scripts/seed-admin.ts",
    "content:sync": "tsx src/scripts/sync-content.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.57",
    "@colyseus/schema": "^2.0.36",
    "@colyseus/ws-transport": "^0.15.3",
    "@prisma/client": "^6.3.1",
    "@witchcraft/shared": "*",
    "colyseus": "^0.15.57",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
