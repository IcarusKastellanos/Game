{
  "name": "witchcraft-sim",
  "version": "0.1.0",
  "private": true,
  "description": "16-bit multiplayer witchcraft life-sim RPG",
  "workspaces": [
    "client",
    "server",
    "shared",
    "admin-client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:admin": "npm run dev -w admin-client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w shared && npm run lint -w server && npm run lint -w client && npm run lint -w admin-client",
    "postinstall": "npm run build -w shared && npm run db:generate",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "npm run db:seed -w server",
    "db:seed:admin": "npm run db:seed:admin -w server",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:env": "node scripts/ensure-env.mjs",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:setup": "node scripts/ensure-env.mjs && npm run db:up && npm run db:wait && npm run db:push && npm run db:seed:admin",
    "content:sync": "npm run content:sync -w server",
    "assets:aura": "node scripts/generate-aura-ui-assets.mjs",
    "setup": "npm install && npm run db:setup"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
