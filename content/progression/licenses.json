{
  "schemaVersion": 1,
  "note": "Magical Council credentials — stronger than recognition tiers. Exams charge a fee, bind a vow, and open credential-only content. Violations spend Licensure Marks.",
  "vows": [
    {
      "id": "vow_healer",
      "label": "Healer's Vow",
      "text": "I will not knowingly harm through my craft. My hands are for mending; baneful work is forbidden while I hold this seal."
    },
    {
      "id": "vow_warder",
      "label": "Warder's Vow",
      "text": "I keep thresholds honest. I will not sell false seals or abandon a ward I have accepted payment to maintain."
    },
    {
      "id": "vow_seer",
      "label": "Seer's Vow",
      "text": "I will not invent omens for coin, nor pry where consent is refused. Sight is a trust."
    },
    {
      "id": "vow_exorcist",
      "label": "Exorcist's Vow",
      "text": "I confront what clings. I will not bargain spirits into households for spectacle or spite."
    },
    {
      "id": "vow_hex",
      "label": "Hexworker's Compact",
      "text": "I accept that healing is not my path. Baneful craft is my trade; restorative work is weak in my hands and stays so by choice."
    }
  ],
